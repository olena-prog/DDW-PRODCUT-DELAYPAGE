<style>
.ymal-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem; }
@media (min-width: 768px) { .ymal-grid { grid-template-columns: repeat(4, 1fr); gap: 1.25rem; } }
.ymal-card { background: rgba(255,255,255,0.1); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-radius: 0.5rem; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); transition: transform 0.4s ease; }
@media (min-width: 768px) { .ymal-card { border-radius: 0.75rem; } }
.ymal-card:hover { transform: translateY(-4px); }
.ymal-card__image { position: relative; height: 6rem; overflow: hidden; background: rgba(255,255,255,0.05); }
@media (min-width: 768px) { .ymal-card__image { height: 12rem; } }
.ymal-card__img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s ease; }
.ymal-card:hover .ymal-card__img { transform: scale(1.05); }
.ymal-card__placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }
.ymal-card__placeholder span { font-family: var(--font-heading); font-size: 1.875rem; color: rgba(255,255,255,0.1); }
@media (min-width: 768px) { .ymal-card__placeholder span { font-size: 3rem; } }
.ymal-card__content { padding: 0.5rem; }
@media (min-width: 768px) { .ymal-card__content { padding: 1rem; } }
.ymal-card__title { font-family: var(--font-heading); font-size: 0.625rem; font-weight: 700; color: var(--color-white); margin-bottom: 0.125rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
@media (min-width: 768px) { .ymal-card__title { font-size: 0.875rem; } }
.ymal-card__subtitle { font-size: 0.5625rem; color: rgba(255,255,255,0.5); margin-bottom: 0.375rem; }
@media (min-width: 768px) { .ymal-card__subtitle { font-size: 0.75rem; margin-bottom: 0.5rem; } }
.ymal-card__footer { display: flex; flex-direction: column; align-items: flex-start; gap: 0.25rem; }
@media (min-width: 768px) { .ymal-card__footer { flex-direction: row; align-items: center; justify-content: space-between; gap: 0.375rem; } }
.ymal-card__price { font-family: var(--font-heading); font-size: 0.625rem; font-weight: 700; color: var(--color-mint); }
@media (min-width: 768px) { .ymal-card__price { font-size: 0.875rem; } }
</style>

<style>
  {%- case section.settings.heading_size -%}
    {%- when 'small' -%}
      #shopify-section-{{ section.id }} .dynamo-heading { font-size: 1.125rem; }
      @media(min-width:768px){#shopify-section-{{ section.id }} .dynamo-heading{font-size:1.5rem;}}
    {%- when 'medium' -%}
      #shopify-section-{{ section.id }} .dynamo-heading { font-size: 1.5rem; }
      @media(min-width:768px){#shopify-section-{{ section.id }} .dynamo-heading{font-size:2rem;}}
    {%- when 'extra-large' -%}
      #shopify-section-{{ section.id }} .dynamo-heading { font-size: 2.25rem; }
      @media(min-width:768px){#shopify-section-{{ section.id }} .dynamo-heading{font-size:3.75rem;}}
  {%- endcase -%}
  {%- case section.settings.body_size -%}
    {%- when 'small' -%}
      #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li { font-size: 0.75rem; }
    {%- when 'large' -%}
      #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li { font-size: 1rem; }
  {%- endcase -%}
  {%- if section.settings.text_alignment != blank -%}
    #shopify-section-{{ section.id }} .dynamo-section-header { text-align: {{ section.settings.text_alignment }}; }
  {%- endif -%}
  {%- if section.settings.bg_color != blank -%}
    #shopify-section-{{ section.id }} > section { background-color: {{ section.settings.bg_color }}; }
  {%- endif -%}
  {%- if section.settings.heading_color != blank -%}
    #shopify-section-{{ section.id }} h1, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h3, #shopify-section-{{ section.id }} .dynamo-heading, #shopify-section-{{ section.id }} .ymal-card__title, #shopify-section-{{ section.id }} .ymal-card__price { color: {{ section.settings.heading_color }} !important; }
  {%- endif -%}
  {%- if section.settings.text_color != blank -%}
    #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li span, #shopify-section-{{ section.id }} .dynamo-body, #shopify-section-{{ section.id }} .ymal-card__subtitle { color: {{ section.settings.text_color }} !important; }
  {%- endif -%}
  {%- if section.settings.block_bg_color != blank -%}
    #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} .faq-item, #shopify-section-{{ section.id }} .ymal-card { background-color: {{ section.settings.block_bg_color }} !important; }
  {%- endif -%}
</style>

<section class="dynamo-section section-teal">
  <div class="dynamo-container" style="max-width: 72rem;">
    <div class="dynamo-section-header">
      <p class="dynamo-eyebrow" style="color: var(--color-mint);">{{ section.settings.eyebrow }}</p>
      <h2 class="dynamo-heading dynamo-heading--lg" style="color: var(--color-white);">{{ section.settings.heading }}</h2>
    </div>

    <div class="ymal-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product_card' -%}
          <div class="ymal-card" {{ block.shopify_attributes }}>
            <div class="ymal-card__image">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 400 }}"
                  srcset="{{ block.settings.image | image_url: width: 200 }} 200w, {{ block.settings.image | image_url: width: 400 }} 400w"
                  sizes="(max-width: 768px) 50vw, 25vw"
                  alt="{{ block.settings.title | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  class="ymal-card__img"
                >
              {%- else -%}
                <div class="ymal-card__placeholder">
                  <span>{{ block.settings.title | slice: 0, 1 | upcase }}</span>
                </div>
              {%- endif -%}
            </div>
            <div class="ymal-card__content">
              <h3 class="ymal-card__title">{{ block.settings.title }}</h3>
              <p class="ymal-card__subtitle">{{ block.settings.subtitle }}</p>
              <div class="ymal-card__footer">
                <p class="ymal-card__price">{{ block.settings.price }}</p>
                {%- if block.settings.button_url != blank -%}
                  <a href="{{ block.settings.button_url }}" target="_blank" rel="noopener noreferrer">
                    <button type="button" class="dynamo-btn dynamo-btn--primary dynamo-btn--small">
                      Shop
                      <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </button>
                  </a>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lovable You May Also Like",
  "tag": "section",
  "class": "shopify-section--ymal",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Complete Your Kit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    },
    {
      "type": "header",
      "content": "Layout & Styling"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "extra-large", "label": "Extra Large" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "body_size",
      "label": "Body Text Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body Text Color"
    },
    {
      "type": "color",
      "id": "block_bg_color",
      "label": "Card/Block Background Color"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Product Title",
          "default": "Dynamo Delay Spray"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "13% Lidocaine — Maximum strength"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "From $18.99"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Product URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lovable You May Also Like",
      "blocks": [
        { "type": "product_card", "settings": { "title": "Dynamo Delay Spray", "subtitle": "13% Lidocaine — Maximum strength", "price": "From $18.99" } },
        { "type": "product_card", "settings": { "title": "Delay Wipes 18ct", "subtitle": "Save 17%", "price": "$29.99" } },
        { "type": "product_card", "settings": { "title": "Delay Wipes 36ct", "subtitle": "Best Value · Save 31%", "price": "$49.99" } },
        { "type": "product_card", "settings": { "title": "Date Night Kit", "subtitle": "Complete couples kit", "price": "$34.99" } }
      ]
    }
  ]
}
{% endschema %}
