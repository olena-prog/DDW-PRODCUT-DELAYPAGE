{{ 'dynamo-comparison.css' | asset_url | stylesheet_tag }}

<section class="dynamo-section section-white">
  <div class="dynamo-container" style="max-width: 80rem;">
    <!-- Section Header -->
    <div class="dynamo-section-header">
      <p class="dynamo-eyebrow" style="color: var(--color-teal);">{{ section.settings.eyebrow }}</p>
      <h2 class="dynamo-heading dynamo-heading--xl">{{ section.settings.heading }}</h2>
    </div>

    <!-- VS Comparison Area -->
    <div class="comparison-vs">
      <div class="comparison-vs__item comparison-vs__item--dynamo">
        {%- if section.settings.dynamo_image != blank -%}
          <img
            src="{{ section.settings.dynamo_image | image_url: width: 256 }}"
            srcset="{{ section.settings.dynamo_image | image_url: width: 192 }} 192w, {{ section.settings.dynamo_image | image_url: width: 256 }} 256w"
            sizes="(max-width: 767px) 6rem, 8rem"
            alt="{{ section.settings.dynamo_image.alt | default: 'Dynamo Delay Wipes' | escape }}"
            loading="lazy"
            width="{{ section.settings.dynamo_image.width }}"
            height="{{ section.settings.dynamo_image.height }}"
            class="comparison-vs__img"
          >
        {%- else -%}
          <div class="dynamo-image-placeholder comparison-vs__placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
        <span class="comparison-vs__label comparison-vs__label--dynamo">{{ section.settings.dynamo_label }}</span>
      </div>

      <div class="comparison-vs__badge">VS</div>

      <div class="comparison-vs__item comparison-vs__item--others">
        {%- if section.settings.others_image != blank -%}
          <img
            src="{{ section.settings.others_image | image_url: width: 256 }}"
            srcset="{{ section.settings.others_image | image_url: width: 192 }} 192w, {{ section.settings.others_image | image_url: width: 256 }} 256w"
            sizes="(max-width: 767px) 6rem, 8rem"
            alt="{{ section.settings.others_image.alt | default: 'Other delay wipes' | escape }}"
            loading="lazy"
            width="{{ section.settings.others_image.width }}"
            height="{{ section.settings.others_image.height }}"
            class="comparison-vs__img"
          >
        {%- else -%}
          <div class="dynamo-image-placeholder comparison-vs__placeholder">
            {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
        <span class="comparison-vs__label comparison-vs__label--others">{{ section.settings.others_label }}</span>
      </div>
    </div>

    <!-- Comparison Table -->
    <div class="comparison-table">
      <!-- Table Header -->
      <div class="comparison-row comparison-row--header">
        <div class="comparison-cell comparison-cell--feature">Feature</div>
        <div class="comparison-cell comparison-cell--dynamo">{{ section.settings.dynamo_label }}</div>
        <div class="comparison-cell comparison-cell--others">{{ section.settings.others_label }}</div>
      </div>

      <!-- Table Body -->
      {%- for block in section.blocks -%}
        {%- if block.type == 'comparison_row' -%}
          <div class="comparison-row" {{ block.shopify_attributes }}>
            <div class="comparison-cell comparison-cell--feature">
              {{ block.settings.feature_name }}
            </div>
            <div class="comparison-cell comparison-cell--dynamo">
              {%- if block.settings.dynamo_is_check -%}
                <svg class="comparison-check comparison-check--yes" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              {%- else -%}
                <span class="comparison-value">{{ block.settings.dynamo_value }}</span>
              {%- endif -%}
            </div>
            <div class="comparison-cell comparison-cell--others">
              {%- if block.settings.others_is_check -%}
                <svg class="comparison-check comparison-check--yes" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              {%- else -%}
                <span class="comparison-value comparison-value--others">{{ block.settings.others_value }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Why Dynamo Wins -->
    <div class="comparison-wins">
      <h3 class="comparison-wins__heading">{{ section.settings.wins_heading }}</h3>
      <div class="comparison-wins__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'win_point' -%}
            <div class="comparison-wins__item" {{ block.shopify_attributes }}>
              <svg class="comparison-wins__check" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              <span>{{ block.settings.text }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

