        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body Text Color"
    },
    {
      "type": "color",
      "id": "block_bg_color",
      "label": "Card/Block Background Color"
    }
  ],
  "blocks": [
    {
      "type": "comparison_row",
      "name": "Comparison Row",
      "settings": [
        {
          "type": "text",
          "id": "feature_name",
          "label": "Feature Name",
          "default": "Feature"
        },
        {
          "type": "text",
          "id": "dynamo_value",
          "label": "Dynamo Value",
          "default": "Yes"
        },
        {
          "type": "text",
          "id": "others_value",
          "label": "Others Value",
          "default": "No"
        },
        {
          "type": "checkbox",
          "id": "dynamo_is_check",
          "label": "Show checkmark for Dynamo",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "others_is_check",
          "label": "Show checkmark for Others",
          "default": false
        }
      ]
    },
    {
      "type": "win_point",
      "name": "Win Point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Win Point Text",
          "default": "Clinically proven ingredients"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lovable Comparison",
      "blocks": [
        { "type": "comparison_row", "settings": { "feature_name": "Active Ingredient", "dynamo_value": "4% Benzocaine", "others_value": "Lidocaine / unknown", "dynamo_is_check": false, "others_is_check": false } },
        { "type": "comparison_row", "settings": { "feature_name": "Wipes Per Pack", "dynamo_value": "10 wipes", "others_value": "4\u20136 wipes", "dynamo_is_check": false, "others_is_check": false } },
        { "type": "comparison_row", "settings": { "feature_name": "Price Per Wipe", "dynamo_value": "~$1.50", "others_value": "~$3.00+", "dynamo_is_check": false, "others_is_check": false } },
        { "type": "comparison_row", "settings": { "feature_name": "Individually Wrapped", "dynamo_value": "", "others_value": "Varies", "dynamo_is_check": true, "others_is_check": false } },
        { "type": "comparison_row", "settings": { "feature_name": "Fast Drying", "dynamo_value": "", "others_value": "Often sticky", "dynamo_is_check": true, "others_is_check": false } },
        { "type": "comparison_row", "settings": { "feature_name": "Wallet-Friendly", "dynamo_value": "", "others_value": "Premium pricing", "dynamo_is_check": true, "others_is_check": false } },
        { "type": "comparison_row", "settings": { "feature_name": "No Prescription", "dynamo_value": "", "others_value": "", "dynamo_is_check": true, "others_is_check": true } },
        { "type": "comparison_row", "settings": { "feature_name": "Made in USA", "dynamo_value": "", "others_value": "Varies", "dynamo_is_check": true, "others_is_check": false } },
        { "type": "win_point", "settings": { "text": "More wipes per pack at a lower cost per use" } },
        { "type": "win_point", "settings": { "text": "Clinically proven 4% Benzocaine formula" } },
        { "type": "win_point", "settings": { "text": "Individually wrapped for on-the-go convenience" } },
        { "type": "win_point", "settings": { "text": "Fast-drying, no sticky residue, made in the USA" } }
      ]
    }
  ]
}
{% endschema %}
