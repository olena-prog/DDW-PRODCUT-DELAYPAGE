      "label": "Heading",
      "default": "Not Your Average <span style='color: var(--color-orange);'>Delay Wipe</span>"
    },
    {
      "type": "header",
      "content": "VS Comparison Images"
    },
    {
      "type": "image_picker",
      "id": "dynamo_image",
      "label": "Dynamo Image"
    },
    {
      "type": "image_picker",
      "id": "others_image",
      "label": "Others Image"
    },
    {
      "type": "text",
      "id": "dynamo_label",
      "label": "Dynamo Label",
      "default": "Dynamo"
    },
    {
      "type": "text",
      "id": "others_label",
      "label": "Others Label",
      "default": "Others"
    },
    {
      "type": "header",
      "content": "Why Dynamo Wins"
    },
    {
      "type": "text",
      "id": "wins_heading",
      "label": "Wins Section Heading",
      "default": "Why Dynamo Wins"
    },
    {
      "type": "header",
      "content": "Layout & Styling"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "extra-large", "label": "Extra Large" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "body_size",
      "label": "Body Text Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
