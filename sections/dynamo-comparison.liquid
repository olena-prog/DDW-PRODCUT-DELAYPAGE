<style>
.comparison-vs { display: flex; align-items: center; justify-content: center; gap: 1.5rem; margin-bottom: 1.5rem; }
@media (min-width: 768px) { .comparison-vs { gap: 2rem; } }
.comparison-vs__item { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; }
.comparison-vs__item--dynamo .comparison-vs__img,
.comparison-vs__item--dynamo .comparison-vs__placeholder { width: 6rem; height: 6rem; border-radius: 1rem; overflow: hidden; border: 2px solid var(--color-mint); box-shadow: var(--shadow-card); object-fit: cover; }
@media (min-width: 768px) { .comparison-vs__item--dynamo .comparison-vs__img, .comparison-vs__item--dynamo .comparison-vs__placeholder { width: 8rem; height: 8rem; } }
.comparison-vs__item--others .comparison-vs__img,
.comparison-vs__item--others .comparison-vs__placeholder { width: 6rem; height: 6rem; border-radius: 1rem; overflow: hidden; border: 2px solid rgba(178,190,195,0.3); opacity: 0.6; object-fit: cover; }
@media (min-width: 768px) { .comparison-vs__item--others .comparison-vs__img, .comparison-vs__item--others .comparison-vs__placeholder { width: 8rem; height: 8rem; } }
.comparison-vs__placeholder { display: flex; align-items: center; justify-content: center; background-color: rgba(178,190,195,0.15); }
.comparison-vs__label { font-family: var(--font-heading); font-size: 0.8125rem; font-weight: 600; }
@media (min-width: 768px) { .comparison-vs__label { font-size: 0.9375rem; } }
.comparison-vs__label--dynamo { color: var(--color-teal); }
.comparison-vs__label--others { color: var(--color-steel); }
.comparison-vs__badge { font-family: var(--font-heading); font-size: 0.875rem; font-weight: 800; color: var(--color-charcoal); background: var(--bg-cream); border: 2px solid rgba(178,190,195,0.3); width: 2.5rem; height: 2.5rem; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
@media (min-width: 768px) { .comparison-vs__badge { font-size: 1rem; width: 3rem; height: 3rem; } }
.comparison-table { border-radius: 1rem; overflow: hidden; box-shadow: var(--shadow-card); border: 1px solid rgba(178,190,195,0.25); }
.comparison-row--header { display: grid; grid-template-columns: 1fr 1fr 1fr; background-color: var(--color-teal); }
.comparison-row--header .comparison-cell { padding: 0.75rem 1rem; font-family: var(--font-heading); font-size: 0.6875rem; font-weight: 700; color: var(--color-white); text-transform: uppercase; letter-spacing: 0.05em; border-top: none; }
@media (min-width: 768px) { .comparison-row--header .comparison-cell { padding: 1rem 1.5rem; font-size: 0.8125rem; } }
.comparison-row { display: grid; grid-template-columns: 1fr 1fr 1fr; border-top: 1px solid rgba(178,190,195,0.2); }
.comparison-row:nth-child(even) { background-color: var(--bg-cream); }
.comparison-row:nth-child(odd):not(.comparison-row--header) { background-color: var(--color-white); }
.comparison-cell { padding: 0.75rem 1rem; font-size: 0.75rem; line-height: 1.5; display: flex; align-items: center; word-break: break-word; min-width: 0; }
@media (min-width: 768px) { .comparison-cell { padding: 1rem 1.5rem; font-size: 0.875rem; } }
.comparison-cell--feature { font-weight: 600; color: var(--color-charcoal); }
.comparison-cell--dynamo { color: var(--color-teal); font-weight: 500; }
.comparison-cell--others { color: rgba(45,52,54,0.55); }
.comparison-check { width: 1.25rem; height: 1.25rem; flex-shrink: 0; }
.comparison-check--yes { color: var(--color-mint); }
.comparison-value { display: inline-block; }
.comparison-value--others { opacity: 0.8; }
.comparison-wins { margin-top: 2rem; background-color: var(--color-teal); border-radius: 1rem; padding: 1.5rem; }
@media (min-width: 768px) { .comparison-wins { padding: 2rem; } }
.comparison-wins__heading { font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; color: var(--color-white); margin-bottom: 1.25rem; text-align: center; }
@media (min-width: 768px) { .comparison-wins__heading { font-size: 1.5rem; margin-bottom: 1.5rem; } }
.comparison-wins__grid { display: grid; grid-template-columns: 1fr; gap: 0.75rem; }
@media (min-width: 640px) { .comparison-wins__grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; } }
.comparison-wins__item { display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.875rem; color: rgba(255,255,255,0.8); line-height: 1.5; }
.comparison-wins__check { width: 1.25rem; height: 1.25rem; color: var(--color-mint); flex-shrink: 0; margin-top: 0.0625rem; }
</style>

<style>
  {%- case section.settings.heading_size -%}
    {%- when 'small' -%}
      #shopify-section-{{ section.id }} .dynamo-heading { font-size: 1.125rem; }
      @media(min-width:768px){#shopify-section-{{ section.id }} .dynamo-heading{font-size:1.5rem;}}
    {%- when 'medium' -%}
      #shopify-section-{{ section.id }} .dynamo-heading { font-size: 1.5rem; }
      @media(min-width:768px){#shopify-section-{{ section.id }} .dynamo-heading{font-size:2rem;}}
    {%- when 'extra-large' -%}
      #shopify-section-{{ section.id }} .dynamo-heading { font-size: 2.25rem; }
      @media(min-width:768px){#shopify-section-{{ section.id }} .dynamo-heading{font-size:3.75rem;}}
  {%- endcase -%}
  {%- case section.settings.body_size -%}
    {%- when 'small' -%}
      #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li { font-size: 0.75rem; }
    {%- when 'large' -%}
      #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li { font-size: 1rem; }
  {%- endcase -%}
  {%- if section.settings.text_alignment != blank -%}
    #shopify-section-{{ section.id }} .dynamo-section-header { text-align: {{ section.settings.text_alignment }}; }
  {%- endif -%}
  {%- if section.settings.bg_color != blank -%}
    #shopify-section-{{ section.id }} > section { background-color: {{ section.settings.bg_color }}; }
  {%- endif -%}
  {%- if section.settings.heading_color != blank -%}
    #shopify-section-{{ section.id }} h1, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h3, #shopify-section-{{ section.id }} .dynamo-heading { color: {{ section.settings.heading_color }} !important; }
  {%- endif -%}
  {%- if section.settings.text_color != blank -%}
    #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li span, #shopify-section-{{ section.id }} .dynamo-body { color: {{ section.settings.text_color }} !important; }
  {%- endif -%}
  {%- if section.settings.block_bg_color != blank -%}
    #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} .comparison-wins { background-color: {{ section.settings.block_bg_color }} !important; }
  {%- endif -%}
</style>

<section class="dynamo-section section-white">
  <div class="dynamo-container" style="max-width: 80rem;">
    <!-- Section Header -->
    <div class="dynamo-section-header">
      <p class="dynamo-eyebrow" style="color: var(--color-teal);">{{ section.settings.eyebrow }}</p>
      <h2 class="dynamo-heading dynamo-heading--xl">{{ section.settings.heading }}</h2>
    </div>

    <!-- VS Comparison Area -->
    <div class="comparison-vs">
      <div class="comparison-vs__item comparison-vs__item--dynamo">
        {%- if section.settings.dynamo_image != blank -%}
          <img
            src="{{ section.settings.dynamo_image | image_url: width: 256 }}"
            srcset="{{ section.settings.dynamo_image | image_url: width: 192 }} 192w, {{ section.settings.dynamo_image | image_url: width: 256 }} 256w"
            sizes="(max-width: 767px) 6rem, 8rem"
            alt="{{ section.settings.dynamo_image.alt | default: 'Dynamo Delay Wipes' | escape }}"
            loading="lazy"
            width="{{ section.settings.dynamo_image.width }}"
            height="{{ section.settings.dynamo_image.height }}"
            class="comparison-vs__img"
          >
        {%- else -%}
          <div class="dynamo-image-placeholder comparison-vs__placeholder">
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
        <span class="comparison-vs__label comparison-vs__label--dynamo">{{ section.settings.dynamo_label }}</span>
      </div>

      <div class="comparison-vs__badge">VS</div>

      <div class="comparison-vs__item comparison-vs__item--others">
        {%- if section.settings.others_image != blank -%}
          <img
            src="{{ section.settings.others_image | image_url: width: 256 }}"
            srcset="{{ section.settings.others_image | image_url: width: 192 }} 192w, {{ section.settings.others_image | image_url: width: 256 }} 256w"
            sizes="(max-width: 767px) 6rem, 8rem"
            alt="{{ section.settings.others_image.alt | default: 'Other delay wipes' | escape }}"
            loading="lazy"
            width="{{ section.settings.others_image.width }}"
            height="{{ section.settings.others_image.height }}"
            class="comparison-vs__img"
          >
        {%- else -%}
          <div class="dynamo-image-placeholder comparison-vs__placeholder">
            {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
        <span class="comparison-vs__label comparison-vs__label--others">{{ section.settings.others_label }}</span>
      </div>
    </div>

    <!-- Comparison Table -->
    <div class="comparison-table">
      <!-- Table Header -->
      <div class="comparison-row comparison-row--header">
        <div class="comparison-cell comparison-cell--feature">Feature</div>
        <div class="comparison-cell comparison-cell--dynamo">{{ section.settings.dynamo_label }}</div>
        <div class="comparison-cell comparison-cell--others">{{ section.settings.others_label }}</div>
      </div>

      <!-- Table Body -->
      {%- for block in section.blocks -%}
        {%- if block.type == 'comparison_row' -%}
          <div class="comparison-row" {{ block.shopify_attributes }}>
            <div class="comparison-cell comparison-cell--feature">
              {{ block.settings.feature_name }}
            </div>
            <div class="comparison-cell comparison-cell--dynamo">
              {%- if block.settings.dynamo_is_check -%}
                <svg class="comparison-check comparison-check--yes" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              {%- else -%}
                <span class="comparison-value">{{ block.settings.dynamo_value }}</span>
              {%- endif -%}
            </div>
            <div class="comparison-cell comparison-cell--others">
              {%- if block.settings.others_is_check -%}
                <svg class="comparison-check comparison-check--yes" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              {%- else -%}
                <span class="comparison-value comparison-value--others">{{ block.settings.others_value }}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Why Dynamo Wins -->
    <div class="comparison-wins">
      <h3 class="comparison-wins__heading">{{ section.settings.wins_heading }}</h3>
      <div class="comparison-wins__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'win_point' -%}
            <div class="comparison-wins__item" {{ block.shopify_attributes }}>
              <svg class="comparison-wins__check" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              <span>{{ block.settings.text }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lovable Comparison",
  "tag": "section",
  "class": "shopify-section--comparison",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Comparison"
    },
    {
      "type": "html",
