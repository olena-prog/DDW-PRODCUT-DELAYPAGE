<style>
.problem-grid { display: grid; gap: 2rem; align-items: center; }
@media (min-width: 1024px) { .problem-grid { grid-template-columns: repeat(2, 1fr); } }
.problem-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2rem; }
.problem-stat { text-align: center; }
.problem-stat__value { display: block; font-family: var(--font-heading); font-size: 1.5rem; font-weight: 800; color: var(--color-white); line-height: 1.2; }
@media (min-width: 768px) { .problem-stat__value { font-size: 2.5rem; } }
.problem-stat__label { display: block; font-size: 0.625rem; color: var(--color-steel); line-height: 1.4; margin-top: 0.25rem; }
@media (min-width: 768px) { .problem-stat__label { font-size: 0.6875rem; } }
.problem-divider { height: 1px; background: linear-gradient(to right, rgba(78,205,196,0.4), transparent); margin: 1.5rem 0; }
.problem-body { font-size: 0.875rem; line-height: 1.7; color: rgba(255,255,255,0.7); }
@media (min-width: 768px) { .problem-body { font-size: 1rem; } }
.problem-solution__card { background: rgba(255,255,255,0.1); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.1); border-radius: 1rem; padding: 1.5rem; }
@media (min-width: 768px) { .problem-solution__card { padding: 2rem; } }
.problem-solution__icon { width: 3rem; height: 3rem; border-radius: 0.75rem; background: rgba(78,205,196,0.2); display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem; }
.problem-solution__heading { font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; color: var(--color-white); margin-bottom: 0.75rem; }
@media (min-width: 768px) { .problem-solution__heading { font-size: 1.5rem; } }
.problem-solution__desc { font-size: 0.875rem; line-height: 1.7; color: rgba(255,255,255,0.7); margin-bottom: 1.25rem; }
.problem-solution__list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem; }
.problem-solution__item { display: flex; align-items: center; gap: 0.75rem; font-size: 0.875rem; color: rgba(255,255,255,0.8); }
.problem-solution__dot { width: 0.375rem; height: 0.375rem; border-radius: 50%; background-color: var(--color-mint); flex-shrink: 0; }
.shopify-section--the-problem { overflow-x: hidden; }
</style>

<style>
  {%- case section.settings.heading_size -%}
    {%- when 'small' -%}
      #shopify-section-{{ section.id }} .dynamo-heading { font-size: 1.125rem; }
      @media(min-width:768px){#shopify-section-{{ section.id }} .dynamo-heading{font-size:1.5rem;}}
    {%- when 'medium' -%}
      #shopify-section-{{ section.id }} .dynamo-heading { font-size: 1.5rem; }
      @media(min-width:768px){#shopify-section-{{ section.id }} .dynamo-heading{font-size:2rem;}}
    {%- when 'extra-large' -%}
      #shopify-section-{{ section.id }} .dynamo-heading { font-size: 2.25rem; }
      @media(min-width:768px){#shopify-section-{{ section.id }} .dynamo-heading{font-size:3.75rem;}}
  {%- endcase -%}
  {%- case section.settings.body_size -%}
    {%- when 'small' -%}
      #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li { font-size: 0.75rem; }
    {%- when 'large' -%}
      #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li { font-size: 1rem; }
  {%- endcase -%}
  {%- if section.settings.text_alignment != blank -%}
    #shopify-section-{{ section.id }} .dynamo-section-header { text-align: {{ section.settings.text_alignment }}; }
  {%- endif -%}
  {%- if section.settings.bg_color != blank -%}
    #shopify-section-{{ section.id }} > section { background-color: {{ section.settings.bg_color }}; }
  {%- endif -%}
  {%- if section.settings.heading_color != blank -%}
    #shopify-section-{{ section.id }} h1, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h3, #shopify-section-{{ section.id }} .dynamo-heading, #shopify-section-{{ section.id }} .problem-solution__heading, #shopify-section-{{ section.id }} .problem-stat__value { color: {{ section.settings.heading_color }} !important; }
  {%- endif -%}
  {%- if section.settings.text_color != blank -%}
    #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li span, #shopify-section-{{ section.id }} .dynamo-body, #shopify-section-{{ section.id }} .problem-body, #shopify-section-{{ section.id }} .problem-solution__desc, #shopify-section-{{ section.id }} .problem-solution__item { color: {{ section.settings.text_color }} !important; }
  {%- endif -%}
  {%- if section.settings.block_bg_color != blank -%}
    #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} .comparison-wins { background-color: {{ section.settings.block_bg_color }} !important; }
  {%- endif -%}
</style>

<section class="dynamo-section section-teal" style="overflow: hidden;">
  <div class="dynamo-container" style="max-width: 80rem;">
    <div class="problem-grid">
      <!-- Left Column: Stats & Problem Description -->
      <div class="problem-content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="dynamo-eyebrow" style="color: var(--color-mint);">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="dynamo-heading dynamo-heading--xl" style="color: var(--color-white);">{{ section.settings.heading }}</h2>
        {%- endif -%}

        <!-- Stats Grid -->
        <div class="problem-stats">
          <div class="problem-stat">
            <span class="problem-stat__value">{{ section.settings.stat_1_value }}</span>
            <span class="problem-stat__label">{{ section.settings.stat_1_label }}</span>
          </div>
          <div class="problem-stat">
            <span class="problem-stat__value">{{ section.settings.stat_2_value }}</span>
            <span class="problem-stat__label">{{ section.settings.stat_2_label }}</span>
          </div>
          <div class="problem-stat">
            <span class="problem-stat__value">{{ section.settings.stat_3_value }}</span>
            <span class="problem-stat__label">{{ section.settings.stat_3_label }}</span>
          </div>
        </div>

        <!-- Divider -->
        <div class="problem-divider"></div>

        {%- if section.settings.body_text != blank -%}
          <p class="problem-body">{{ section.settings.body_text }}</p>
        {%- endif -%}
      </div>

      <!-- Right Column: Solution Glass Card -->
      <div class="problem-solution">
        <div class="problem-solution__card">
          <div class="problem-solution__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-mint)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
          </div>

          {%- if section.settings.solution_heading != blank -%}
            <h3 class="problem-solution__heading">{{ section.settings.solution_heading }}</h3>
          {%- endif -%}

          {%- if section.settings.solution_description != blank -%}
            <p class="problem-solution__desc">{{ section.settings.solution_description }}</p>
          {%- endif -%}

          <ul class="problem-solution__list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'solution_point' -%}
                <li class="problem-solution__item" {{ block.shopify_attributes }}>
                  <span class="problem-solution__dot"></span>
                  <span>{{ block.settings.text }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lovable The Problem",
  "tag": "section",
  "class": "shopify-section--the-problem",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "The Problem"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "You're Not Alone — PE Affects <span style='color: var(--color-mint);'>1 in 3 Men</span>"
    },
    {
      "type": "text",
      "id": "stat_1_value",
      "label": "Stat 1 Value",
      "default": "30%"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 Label",
      "default": "of men experience PE at some point"
    },
    {
      "type": "text",
      "id": "stat_2_value",
      "label": "Stat 2 Value",
      "default": "75%"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 Label",
      "default": "say it impacts their confidence"
    },
    {
      "type": "text",
      "id": "stat_3_value",
      "label": "Stat 3 Value",
      "default": "#1"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 Label",
      "default": "most common male sexual concern"
    },
    {
      "type": "textarea",
      "id": "body_text",
      "label": "Body Text",
      "default": "Premature ejaculation is the most common sexual performance issue men face — yet most suffer in silence. It affects relationships, self-esteem, and intimacy. The good news? There's a simple, proven solution."
    },
    {
      "type": "header",
      "content": "Solution Card"
    },
    {
      "type": "text",
      "id": "solution_heading",
      "label": "Solution Heading",
      "default": "The Solution Exists"
    },
    {
      "type": "textarea",
      "id": "solution_description",
      "label": "Solution Description",
      "default": "Dynamo Delay Wipes use clinically proven benzocaine to give you the control you've been looking for — discreetly and effectively."
    },
    {
      "type": "header",
      "content": "Layout & Styling"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "extra-large", "label": "Extra Large" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "body_size",
      "label": "Body Text Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body Text Color"
    },
    {
      "type": "color",
      "id": "block_bg_color",
      "label": "Card/Block Background Color"
    }
  ],
  "blocks": [
    {
      "type": "solution_point",
      "name": "Solution Point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Point Text",
          "default": "Clinically proven active ingredient"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lovable The Problem",
      "blocks": [
        { "type": "solution_point", "settings": { "text": "Clinically proven active ingredient" } },
        { "type": "solution_point", "settings": { "text": "Works in just 5–10 minutes" } },
        { "type": "solution_point", "settings": { "text": "No prescription required" } },
        { "type": "solution_point", "settings": { "text": "Discreet, mess-free wipe format" } }
      ]
    }
  ]
}
{% endschema %}
