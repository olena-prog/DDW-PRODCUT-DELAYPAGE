        { "type": "him_point", "settings": { "text": "Last longer with confidence" } },
        { "type": "him_point", "settings": { "text": "Reduce performance anxiety" } },
        { "type": "him_point", "settings": { "text": "Stay in control without losing sensation" } },
        { "type": "him_point", "settings": { "text": "No pills or prescriptions needed" } },
        { "type": "him_point", "settings": { "text": "Boost self-esteem in the bedroom" } },
        { "type": "her_point", "settings": { "text": "More satisfying intimacy" } },
        { "type": "her_point", "settings": { "text": "Deeper emotional connection" } },
        { "type": "her_point", "settings": { "text": "No numbing or transfer to her" } },
        { "type": "her_point", "settings": { "text": "Longer, more enjoyable experiences" } },
        { "type": "her_point", "settings": { "text": "A partner who feels confident" } }
      ]
    }
  ]
}
{% endschema %}
