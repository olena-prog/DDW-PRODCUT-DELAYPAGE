<style>
.benefits-section { padding: 4rem 0; overflow-x: hidden; }
@media (min-width: 768px) { .benefits-section { padding: 5rem 0; } }
.benefits-container { max-width: 80rem; margin: 0 auto; padding: 0 1rem; }
@media (min-width: 768px) { .benefits-container { padding: 0 2rem; } }
.benefits-eyebrow { font-family: var(--font-heading); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-mint); margin: 0 0 0.75rem; }
.benefits-heading { font-family: var(--font-heading); font-size: 1.875rem; font-weight: 700; line-height: 1.2; letter-spacing: -0.02em; color: var(--color-foreground); margin: 0 0 2rem; }
@media (min-width: 768px) { .benefits-heading { font-size: 3rem; } }
.benefits-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
@media (min-width: 1024px) { .benefits-grid { grid-template-columns: 4fr 8fr; gap: 1.5rem; align-items: start; } }
.benefits-sidebar { display: none; position: relative; border-radius: 1rem; overflow: hidden; }
@media (min-width: 1024px) { .benefits-sidebar { display: block; min-height: 480px; } }
.benefits-sidebar img { width: 100%; height: 100%; object-fit: cover; display: block; position: absolute; inset: 0; transition: transform 0.5s ease; }
.benefits-sidebar:hover img { transform: scale(1.05); }
.benefits-sidebar__overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(13,115,119,0.9) 0%, rgba(13,115,119,0.2) 100%); pointer-events: none; z-index: 1; }
.benefits-sidebar__text { position: absolute; bottom: 1.5rem; left: 1.5rem; right: 1.5rem; z-index: 2; }
.benefits-sidebar__heading { font-family: var(--font-heading); font-size: 1.125rem; font-weight: 700; line-height: 1.3; color: var(--color-white); margin: 0 0 0.25rem; }
.benefits-sidebar__subtext { font-size: 0.75rem; line-height: 1.5; color: rgba(255,255,255,0.7); margin: 0; }
.benefits-cards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
@media (min-width: 768px) { .benefits-cards { grid-template-columns: repeat(3, 1fr); gap: 1rem; } }
@media (min-width: 1024px) { .benefits-cards { align-content: start; } }
.benefit-card { background-color: var(--color-teal); border-radius: 0.75rem; padding: 1rem; transition: transform 0.3s ease, box-shadow 0.3s ease; display: flex; flex-direction: column; gap: 0.5rem; }
@media (min-width: 768px) { .benefit-card { padding: 1.25rem; } }
.benefit-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-card-hover); }
.benefit-card__icon { width: 2.75rem; height: 2.75rem; border-radius: 0.5rem; background-color: rgba(78,205,196,0.2); display: flex; align-items: center; justify-content: center; color: var(--color-mint); transition: background-color 0.3s ease, color 0.3s ease, transform 0.3s ease; flex-shrink: 0; }
.benefit-card:hover .benefit-card__icon { background-color: var(--color-mint); color: var(--color-teal); transform: scale(1.05); }
.benefit-card__icon svg { width: 1.25rem; height: 1.25rem; }
.benefit-card__title { font-family: var(--font-heading); font-size: 0.875rem; font-weight: 600; color: var(--color-white); margin: 0; line-height: 1.3; }
.benefit-card__description { font-size: 0.75rem; line-height: 1.6; color: rgba(255,255,255,0.6); margin: 0; }
@media (max-width: 479px) {
  .benefits-section { padding: 3rem 0; }
  .benefits-heading { font-size: 1.5rem; margin-bottom: 1.5rem; }
  .benefits-cards { gap: 0.5rem; }
  .benefit-card { padding: 0.875rem; }
  .benefit-card__icon { width: 2.25rem; height: 2.25rem; }
  .benefit-card__icon svg { width: 1rem; height: 1rem; }
}
</style>

<section class="benefits-section" style="background-color: var(--bg-steel);">
  <div class="benefits-container">
    {%- if section.settings.eyebrow != blank -%}
      <p class="benefits-eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="benefits-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="benefits-grid">
      <!-- Sidebar / Left Column -->
      <div class="benefits-sidebar">
        {%- if section.settings.sidebar_image != blank -%}
          <img
            src="{{ section.settings.sidebar_image | image_url: width: 800 }}"
            srcset="
              {{ section.settings.sidebar_image | image_url: width: 400 }} 400w,
              {{ section.settings.sidebar_image | image_url: width: 600 }} 600w,
              {{ section.settings.sidebar_image | image_url: width: 800 }} 800w
            "
            sizes="(min-width: 1024px) 33vw, 0px"
            alt="{{ section.settings.sidebar_image.alt | escape }}"
            loading="lazy"
            width="{{ section.settings.sidebar_image.width }}"
            height="{{ section.settings.sidebar_image.height }}"
          >
        {%- endif -%}
        <div class="benefits-sidebar__overlay"></div>
        <div class="benefits-sidebar__text">
          {%- if section.settings.sidebar_heading != blank -%}
            <p class="benefits-sidebar__heading">{{ section.settings.sidebar_heading }}</p>
          {%- endif -%}
          {%- if section.settings.sidebar_subtext != blank -%}
            <p class="benefits-sidebar__subtext">{{ section.settings.sidebar_subtext }}</p>
          {%- endif -%}
        </div>
      </div>

      <!-- Benefit Cards / Right Column -->
      <div class="benefits-cards">
        {%- for block in section.blocks -%}
          {%- if block.type == 'benefit' -%}
            <div class="benefit-card" {{ block.shopify_attributes }}>
              <div class="benefit-card__icon">
                {%- case block.settings.icon -%}
                  {%- when 'award' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="8" r="6"/>
                      <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
                    </svg>
                  {%- when 'shield' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
                      <path d="m9 12 2 2 4-4"/>
                    </svg>
                  {%- when 'target' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"/>
                      <circle cx="12" cy="12" r="6"/>
                      <circle cx="12" cy="12" r="2"/>
                    </svg>
                  {%- when 'zap' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>
                    </svg>
                  {%- when 'sparkles' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/>
                      <path d="M20 3v4"/>
                      <path d="M22 5h-4"/>
                      <path d="M4 17v2"/>
                      <path d="M5 18H3"/>
                    </svg>
                  {%- when 'plane' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>
                    </svg>
                {%- endcase -%}
              </div>

              {%- if block.settings.title != blank -%}
                <h3 class="benefit-card__title">{{ block.settings.title }}</h3>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="benefit-card__description">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lovable Benefits",
  "tag": "section",
  "class": "dynamo-benefits",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Benefits"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Men Choose Dynamo"
    },
    {
      "type": "image_picker",
      "id": "sidebar_image",
      "label": "Sidebar image"
    },
    {
      "type": "text",
      "id": "sidebar_heading",
      "label": "Sidebar heading",
      "default": "Trusted by 10,000+ men worldwide"
    },
    {
      "type": "text",
      "id": "sidebar_subtext",
      "label": "Sidebar subtext",
      "default": "Join thousands who have transformed their confidence."
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "award", "label": "Award" },
            { "value": "shield", "label": "Shield" },
            { "value": "target", "label": "Target" },
            { "value": "zap", "label": "Zap" },
            { "value": "sparkles", "label": "Sparkles" },
            { "value": "plane", "label": "Plane" }
          ],
          "default": "award"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Benefit title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Benefit description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lovable Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "award",
            "title": "Clinically Proven",
            "description": "Formulated with benzocaine, a trusted ingredient backed by clinical research for effective delay."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "shield",
            "title": "Ultra-Discreet",
            "description": "Individually wrapped wipes that look like everyday items. No one needs to know."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "target",
            "title": "Targeted Control",
            "description": "Apply exactly where needed for precise, consistent results every time."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "zap",
            "title": "Fast Acting",
            "description": "Starts working within minutes so you can be ready when the moment arrives."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "sparkles",
            "title": "Mess-Free",
            "description": "Clean, simple wipe format with no sticky residue or complicated application."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "plane",
            "title": "Travel-Ready",
            "description": "Compact, TSA-friendly packets that fit in your wallet, pocket, or carry-on."
          }
        }
      ]
    }
  ]
}
{% endschema %}
