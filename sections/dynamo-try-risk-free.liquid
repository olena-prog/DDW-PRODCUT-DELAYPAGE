<style>
.risk-free__icon { width: 4rem; height: 4rem; border-radius: 50%; background: var(--color-teal); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; }
.risk-free__desc { font-size: 1rem; color: rgba(45,52,54,0.7); line-height: 1.6; max-width: 28rem; margin: 0.75rem auto 1.25rem; }
@media (min-width: 768px) { .risk-free__desc { font-size: 1.125rem; margin-bottom: 1.5rem; } }
.risk-free__btn-wrap { display: inline-block; margin-bottom: 1.5rem; }
@media (min-width: 768px) { .risk-free__btn-wrap { margin-bottom: 2rem; } }
.risk-free__btn { padding: 0.875rem 1.5rem; font-size: 1rem; }
@media (min-width: 768px) { .risk-free__btn { padding: 1rem 2.5rem; font-size: 1.125rem; } }
.risk-free__trust { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; max-width: 32rem; margin: 0 auto; }
@media (min-width: 768px) { .risk-free__trust { gap: 1rem; } }
.risk-free__trust-item { text-align: center; }
.risk-free__trust-icon { width: 2.5rem; height: 2.5rem; border-radius: 0.75rem; background: var(--color-teal); display: flex; align-items: center; justify-content: center; margin: 0 auto 0.375rem; transition: transform 0.3s ease; }
@media (min-width: 768px) { .risk-free__trust-icon { width: 3rem; height: 3rem; margin-bottom: 0.5rem; } }
.risk-free__trust-item:hover .risk-free__trust-icon { transform: scale(1.05); }
.risk-free__trust-label { font-size: 0.5625rem; font-weight: 500; color: rgba(45,52,54,0.7); }
@media (min-width: 768px) { .risk-free__trust-label { font-size: 0.625rem; } }
</style>

<style>
  {%- case section.settings.heading_size -%}
    {%- when 'small' -%}
      #shopify-section-{{ section.id }} .dynamo-heading { font-size: 1.125rem; }
      @media(min-width:768px){#shopify-section-{{ section.id }} .dynamo-heading{font-size:1.5rem;}}
    {%- when 'medium' -%}
      #shopify-section-{{ section.id }} .dynamo-heading { font-size: 1.5rem; }
      @media(min-width:768px){#shopify-section-{{ section.id }} .dynamo-heading{font-size:2rem;}}
    {%- when 'extra-large' -%}
      #shopify-section-{{ section.id }} .dynamo-heading { font-size: 2.25rem; }
      @media(min-width:768px){#shopify-section-{{ section.id }} .dynamo-heading{font-size:3.75rem;}}
  {%- endcase -%}
  {%- case section.settings.body_size -%}
    {%- when 'small' -%}
      #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li { font-size: 0.75rem; }
    {%- when 'large' -%}
      #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li { font-size: 1rem; }
  {%- endcase -%}
  {%- if section.settings.text_alignment != blank -%}
    #shopify-section-{{ section.id }} .dynamo-section-header, #shopify-section-{{ section.id }} .risk-free { text-align: {{ section.settings.text_alignment }}; }
  {%- endif -%}
  {%- if section.settings.bg_color != blank -%}
    #shopify-section-{{ section.id }} > section { background-color: {{ section.settings.bg_color }}; }
  {%- endif -%}
  {%- if section.settings.heading_color != blank -%}
    #shopify-section-{{ section.id }} h1, #shopify-section-{{ section.id }} h2, #shopify-section-{{ section.id }} h3, #shopify-section-{{ section.id }} .dynamo-heading { color: {{ section.settings.heading_color }} !important; }
  {%- endif -%}
  {%- if section.settings.text_color != blank -%}
    #shopify-section-{{ section.id }} p, #shopify-section-{{ section.id }} li span, #shopify-section-{{ section.id }} .dynamo-body { color: {{ section.settings.text_color }} !important; }
  {%- endif -%}
  {%- if section.settings.block_bg_color != blank -%}
    #shopify-section-{{ section.id }} [class*="__card"], #shopify-section-{{ section.id }} .faq-item, #shopify-section-{{ section.id }} .ymal-card { background-color: {{ section.settings.block_bg_color }} !important; }
  {%- endif -%}
</style>

<section class="dynamo-section section-cream">
  <div class="dynamo-container" style="max-width: 48rem;">
    <div class="risk-free dynamo-text-center">
      <!-- Shield Icon -->
      <div class="risk-free__icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--color-white)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
      </div>

      <h2 class="dynamo-heading dynamo-heading--xl">{{ section.settings.heading }}</h2>
      <p class="risk-free__desc">{{ section.settings.description }}</p>

      <a href="{{ section.settings.button_url }}" target="_blank" rel="noopener noreferrer" class="risk-free__btn-wrap">
        <button type="button" class="dynamo-btn dynamo-btn--primary risk-free__btn">
          {{ section.settings.button_text }}
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>
      </a>

      <!-- Trust Grid -->
      <div class="risk-free__trust">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust_badge' -%}
            <div class="risk-free__trust-item" {{ block.shopify_attributes }}>
              <div class="risk-free__trust-icon">
                {%- case block.settings.icon -%}
                  {%- when 'award' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-mint)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"/><circle cx="12" cy="8" r="6"/></svg>
                  {%- when 'truck' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-mint)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
                  {%- when 'lock' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-mint)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  {%- when 'shield' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-mint)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
                {%- endcase -%}
              </div>
              <p class="risk-free__trust-label">{{ block.settings.text }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lovable Try Risk-Free",
  "tag": "section",
  "class": "shopify-section--risk-free",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Try Risk-Free"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "30-Day Money-Back Guarantee. Not satisfied? Full refund — no questions asked."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now — Risk Free"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Layout & Styling"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "extra-large", "label": "Extra Large" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "body_size",
      "label": "Body Text Size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body Text Color"
    },
    {
      "type": "color",
      "id": "block_bg_color",
      "label": "Card/Block Background Color"
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Badge Text",
          "default": "Clinically Proven"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "award", "label": "Award" },
            { "value": "truck", "label": "Truck" },
            { "value": "lock", "label": "Lock" },
            { "value": "shield", "label": "Shield" }
          ],
          "default": "award"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lovable Try Risk-Free",
      "blocks": [
        { "type": "trust_badge", "settings": { "text": "Clinically Proven", "icon": "award" } },
        { "type": "trust_badge", "settings": { "text": "Discreet Shipping", "icon": "truck" } },
        { "type": "trust_badge", "settings": { "text": "Secure Payment", "icon": "lock" } },
        { "type": "trust_badge", "settings": { "text": "Made in USA", "icon": "shield" } }
      ]
    }
  ]
}
{% endschema %}
