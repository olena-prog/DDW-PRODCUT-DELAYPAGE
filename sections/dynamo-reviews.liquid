      "label": "Review Count",
      "default": "8"
    },
    {
      "type": "text",
      "id": "written_heading",
      "label": "Written Reviews Heading",
      "default": "Written Reviews"
    }
  ],
  "blocks": [
    {
      "type": "video_review",
      "name": "Video Review",
      "settings": [
        {
          "type": "text",
